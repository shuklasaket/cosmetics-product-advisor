        <mxCell id="followup" value="&lt;b&gt;Ask for clarification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Missing / ambiguous data&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Preserve explicit edits&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C5A56A;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="search" value="&lt;b&gt;Search + details&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Verified local catalog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Approved refresh tools&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#7FA58E;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
