          <mxGeometry x="760" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="explain" value="&lt;b&gt;Generate explanation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bounded local LLM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Selected evidence only&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3EDFB;strokeColor=#9D82BE;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
