        <mxCell id="f-17" value="sanitized events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#62788D;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#52677B;labelBackgroundColor=#FFFFFF;" edge="1" source="display" target="audit" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-rules" value="&lt;b&gt;Eligibility is a hard gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Category + India availability + inclusive INR budget + confirmed exclusions / regulatory checks.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Missing or conflicting critical ingredient evidence stays outside recommendations; stale critical facts cannot qualify.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sponsorship never changes eligibility, score or order. Scores are comparative fit, not safety probabilities.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#9BAAB8;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-bounds" value="&lt;b&gt;Proposed execution bounds and truthful failure paths&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;30 tool invocations · 20 model calls · 5-minute deadline · at most 5 freshly analyzed products per run.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Use cached review findings first; disclose unprocessed / missing evidence. Every model repair counts against limits.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No candidates → empty-state explanation. Source/model failure → validated partial result or explicit failure.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cancel / supersede → stop new calls and prevent late results from overwriting current UI state.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F7;strokeColor=#9BAAB8;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-source" value="Source: TR-05, TR-09–17, TR-19, TR-22–27 · Detailed policies and component meanings remain in the PRDs" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#52677B;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1250" height="25" as="geometry" />
        </mxCell>
