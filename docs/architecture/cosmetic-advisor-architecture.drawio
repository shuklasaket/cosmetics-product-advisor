<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="bounded-role-architecture" name="Bounded role architecture">
    <mxGraphModel page="1" pageWidth="1280" pageHeight="820" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="One local app with a trusted controller and five fixed roles" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#172B4D;fontFamily=Helvetica;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Implemented foundation at the top; planned bounded role workflow below. Only the approved source is remote." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#52657D;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1180" height="30" as="geometry"/></mxCell>
        <mxCell id="user" value="Shopper / operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#365B8C;strokeWidth=2;fontColor=#172B4D;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="ui" value="Streamlit UI&lt;br&gt;form + catalog now&lt;br&gt;conversation later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFC;strokeColor=#365B8C;strokeWidth=2;fontColor=#172B4D;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="235" y="120" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="controller" value="Trusted controller&lt;br&gt;run context, limits, validation,&lt;br&gt;redaction, cancellation, publication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="sqlite" value="SQLite repository&lt;br&gt;evidence, public artifacts,&lt;br&gt;preferences, redacted events" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#274E13;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="115" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="roles" value="Fixed role chain — controller-mediated typed handoffs only" style="swimlane;startSize=30;horizontal=1;whiteSpace=wrap;html=1;fillColor=#F5F0F8;strokeColor=#9673A6;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1160" height="180" as="geometry"/></mxCell>
        <mxCell id="intake" value="1. Intake and&lt;br&gt;Clarification&lt;br&gt;&lt;small&gt;local extraction; no tools&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="roles"><mxGeometry x="25" y="66" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="catalog" value="2. Catalog Evidence&lt;br&gt;&lt;small&gt;allowlisted facts and retrieval&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="roles"><mxGeometry x="245" y="66" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="review" value="3. Review Evidence&lt;br&gt;&lt;small&gt;bounded review model only&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="roles"><mxGeometry x="465" y="66" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="policy" value="4. Policy and Ranking&lt;br&gt;&lt;small&gt;Python-only screening and score&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#274E13;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="roles"><mxGeometry x="685" y="66" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="explain" value="5. Explanation and Citation&lt;br&gt;&lt;small&gt;bounded claims; validated fallback&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="roles"><mxGeometry x="905" y="66" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="session" value="Session only&lt;br&gt;budget, exclusions, raw chat,&lt;br&gt;active results and role payloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontColor=#7F6000;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="275" height="85" as="geometry"/></mxCell>
        <mxCell id="services" value="Shared deterministic services&lt;br&gt;validation, source selection, screening, ranking, citation checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1D3B5B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="535" width="340" height="85" as="geometry"/></mxCell>
        <mxCell id="model" value="Bounded local model adapter&lt;br&gt;Review and Explanation roles only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#3E2A4B;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="535" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="ollama" value="Local Ollama runtime&lt;br&gt;no hosted dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontColor=#333333;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="535" width="160" height="85" as="geometry"/></mxCell>
        <mxCell id="footer" value="Roles cannot delegate, call one another, choose tools, write preferences, or publish results. The controller validates every handoff." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#52657D;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1180" height="28" as="geometry"/></mxCell>
