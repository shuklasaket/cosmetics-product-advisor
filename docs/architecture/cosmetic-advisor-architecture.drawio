          <mxGeometry x="940" y="280" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="withhold" value="&lt;b&gt;Withhold candidate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Excluded / unverified&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Session-only reasons&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C5A56A;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="280" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rank" value="&lt;b&gt;Rank eligible set&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;0.35S + 0.30R&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+ 0.20I + 0.15P&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#7398C5;strokeWidth=1.2;fontColor=#183047;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
