        <mxCell id="limits" value="&lt;b&gt;Bounded execution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#52657D&quot;&gt;Proposed: 30 tool calls · 20 model calls · 5 min&lt;br&gt;At most 5 products freshly review-analyzed*&lt;br&gt;Every retry and repair shares these limits&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F6FA;strokeColor=#A4B3C5;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="930" width="430" height="95" />
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;Failures &amp;amp; cancellation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#52657D&quot;&gt;Source/model failure → validated partial or failed&lt;br&gt;Cancel/supersede → stop calls; reject late results&lt;br&gt;Missing review analysis uses its stated score policy&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEFF0;strokeColor=#C66B74;strokeWidth=1.5;fontColor=#172B4D;fontFamily=Helvetica;fontSize=17;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="930" width="430" height="95" />
        </mxCell>
