<?xml version='1.0' encoding='utf-8'?><mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="incremental-architecture" name="Incremental architecture"><mxGraphModel page="1" pageWidth="1280" pageHeight="790" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One local app, extended in PRD order" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#172B4D;fontFamily=Helvetica;fontSize=29;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="24" width="1130" height="44" as="geometry" /></mxCell><mxCell id="subtitle" value="Top row: implemented foundation. Lower boxes: current session state and planned paths. Only the approved source is remote." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#52657D;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="60" width="1170" height="40" as="geometry" /></mxCell><mxCell id="footer-1" value="Python owns eligibility, ingredient rules, ranking and citation checks. Personal request data stays in the current session." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#52657D;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="674" width="1170" height="30" as="geometry" /></mxCell><mxCell id="footer-2" value="PRD 01 and source contracts are implemented. Refresh, screening, reviews, ranking, explanations, graph, memory and reports follow." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#52657D;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="704" width="1170" height="30" as="geometry" /></mxCell><mxCell id="user" value="Shopper / operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#365B8C;strokeWidth=2;fontC