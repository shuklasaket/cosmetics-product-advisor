# Optional overrides. The application works without a .env file.
# Values are local paths; loading configuration does not create any files.
ADVISOR_DATA_DIR=data/local
ADVISOR_DATABASE_PATH=database/advisor.db
ADVISOR_EXPORT_DIR=exports

# The development foundation has no hosted provider or paid-call path.
# Enabling this before that capability is implemented is a validation error.
ADVISOR_HOSTED_ENABLED=false
